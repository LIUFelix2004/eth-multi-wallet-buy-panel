# Sepolia RPC. Use your Alchemy/Infura/QuickNode URL.
RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Contract that users buy through. This may be your launchpad/router/bonding-curve contract.
BUY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ABI fragment for the buy function.
# Examples:
# BUY_FUNCTION_SIGNATURE=function buy(address token,uint256 minTokensOut) payable
# BUY_FUNCTION_SIGNATURE=function buyToken(address token) payable
# BUY_FUNCTION_SIGNATURE=function buy(uint256 amountOutMin,address to) payable
BUY_FUNCTION_SIGNATURE=function buy(address token,uint256 minTokensOut) payable

# Arguments for the buy function, excluding msg.value.
# Example for buy(address token,uint256 minTokensOut):
BUY_ARGS_JSON=["0xTokenAddressHere","0"]

# ETH sent with each buy transaction.
BUY_VALUE_ETH=0.001

# Optional ERC20 payment token approval before buy.
# Use this when the buy function spends an ERC20 instead of native Sepolia ETH.
PAYMENT_TOKEN_ADDRESS=
APPROVE_AMOUNT=
DEADLINE_SECONDS=3600

# Comma-separated private keys for funded Sepolia test wallets.
# Never put mainnet private keys here.
PRIVATE_KEYS=0xabc...,0xdef...

# Load shape.
TOTAL_BUYS=100
MAX_CONCURRENCY=20

# Optional gas settings. Leave empty to let RPC estimate.
MAX_FEE_GWEI=
MAX_PRIORITY_FEE_GWEI=

# Wait behavior.
WAIT_FOR_RECEIPT=true
RECEIPT_TIMEOUT_MS=180000

# Output report file.
REPORT_PATH=reports/multi-buy-report.json

# Sell test.
SELL_CONTRACT_ADDRESS=
SELL_FUNCTION_SIGNATURE=function sellExactIn(address token,uint256 amountIn,uint256 minAmountOut,uint256 deadline)
SELL_ARGS_JSON=["0xTokenAddressHere","0","0","$DEADLINE"]
SELL_TOKEN_ADDRESS=
SELL_APPROVE_AMOUNT=
TOTAL_SELLS=100
SELL_MAX_CONCURRENCY=15
SELL_REPORT_PATH=reports/multi-sell-report.json

# Borrow test.
BORROW_CONTRACT_ADDRESS=
BORROW_FUNCTION_SIGNATURE=function borrow(address token,uint256 amount)
BORROW_TOKEN_ADDRESS=
DEPOSIT_BEFORE_BORROW=false
DEPOSIT_FUNCTION_SIGNATURE=function deposit(address token,uint256 amount)
COLLATERAL_TOKEN_ADDRESS=
COLLATERAL_RESERVE_AMOUNT=0
MAX_DEPOSIT_AMOUNT=
TOTAL_BORROWS=100
BORROW_MAX_CONCURRENCY=20
BORROW_PROBE_CONCURRENCY=10
BORROW_PROBE_START=1000000000000000000000
BORROW_PROBE_CAP=10000000000000000000000000
BORROW_BINARY_STEPS=48
BORROW_SAFETY_BPS=10000
BORROW_REPORT_PATH=reports/multi-borrow-report.json

# Optional: funding wallet used by npm run fund-wallets.
# Use only a Sepolia test wallet private key.
FUNDING_PRIVATE_KEY=
FUND_ETH_PER_WALLET=0.002
FUND_ETH_TARGET_PER_WALLET=
FUND_TOKEN_AMOUNT_PER_WALLET=100000000000000000000
FUND_TOKEN_TARGET_PER_WALLET=
FUND_MAX_CONCURRENCY=1
FUND_WAIT_FOR_RECEIPT=true
FUND_REPORT_PATH=reports/fund-wallets-report.json
